{% assign cv = site.data.cv.cv %}

<div class="post cv-template-page">
  <header class="post-header">
    <div class="cv-title-row">
      <h1 class="post-title">{{ page.title }}</h1>
      {% if page.cv_pdf %}
        <a class="cv-download-button" href="{{ page.cv_pdf | relative_url }}" download>
          <i class="fa-solid fa-file-pdf"></i>
          下载 PDF 简历
        </a>
      {% endif %}
    </div>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    <div class="cv">
      {% if cv.name or cv.label or cv.email or cv.phone or cv.location or cv.age or cv.website or cv.profiles %}
        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">Contact Information</h3>
          <table class="table table-cv table-sm table-borderless">
            {% if cv.name %}
              <tr>
                <td class="p-1 pr-2 font-weight-bold"><b>Name</b></td>
                <td class="p-1 pl-2 font-weight-light">{{ cv.name }}</td>
              </tr>
            {% endif %}
            {% if cv.label %}
              <tr>
                <td class="p-1 pr-2 font-weight-bold"><b>Direction</b></td>
                <td class="p-1 pl-2 font-weight-light">{{ cv.label }}</td>
              </tr>
            {% endif %}
            {% if cv.email %}
              <tr>
                <td class="p-1 pr-2 font-weight-bold"><b>Email</b></td>
                <td class="p-1 pl-2 font-weight-light"><a href="mailto:{{ cv.email }}">{{ cv.email }}</a></td>
              </tr>
            {% endif %}
            {% if cv.phone %}
              <tr>
                <td class="p-1 pr-2 font-weight-bold"><b>Phone</b></td>
                <td class="p-1 pl-2 font-weight-light"><a href="tel:+8618801336120">{{ cv.phone }}</a></td>
              </tr>
            {% endif %}
            {% if cv.location %}
              <tr>
                <td class="p-1 pr-2 font-weight-bold"><b>Location</b></td>
                <td class="p-1 pl-2 font-weight-light">{{ cv.location }}</td>
              </tr>
            {% endif %}
            {% if cv.age %}
              <tr>
                <td class="p-1 pr-2 font-weight-bold"><b>Age</b></td>
                <td class="p-1 pl-2 font-weight-light">{{ cv.age }}</td>
              </tr>
            {% endif %}
            {% if cv.profiles %}
              {% for profile in cv.profiles %}
                <tr>
                  <td class="p-1 pr-2 font-weight-bold"><b>{{ profile.network }}</b></td>
                  <td class="p-1 pl-2 font-weight-light"><a href="{{ profile.url }}" target="_blank" rel="noopener">{{ profile.url }}</a></td>
                </tr>
              {% endfor %}
            {% endif %}
          </table>
        </div>
      {% endif %}

      {% assign cv_summary = cv.summary | default: '' | strip %}
      {% if cv_summary != '' %}
        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">求职方向</h3>
          <p>{{ cv_summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
        </div>
      {% endif %}

      {% for section_pair in cv.sections %}
        {% assign section_title = section_pair[0] %}
        {% assign section_entries = section_pair[1] %}

        <a class="anchor" id="{{ section_title | slugify }}"></a>
        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">{{ section_title }}</h3>
          <div>
            {% if section_title == '教育经历' or section_title == 'Education' %}
              {% assign entries = section_entries %}
              {% include cv/education.liquid %}
            {% elsif section_title == '实习经历' or section_title == 'Experience' %}
              {% assign entries = section_entries %}
              {% include cv/experience.liquid %}
            {% elsif section_title == '科研项目' or section_title == '个人开发' or section_title == 'Projects' %}
              {% assign entries = section_entries %}
              {% include cv/projects.liquid %}
            {% elsif section_title contains '发表' or section_title == 'Publications' %}
              {% assign entries = section_entries %}
              {% include cv/publications.liquid %}
            {% else %}
              <ul class="card-text font-weight-light list-group list-group-flush">
                {% for entry in section_entries %}
                  <li class="list-group-item">
                    {% if entry.bullet %}
                      {{ entry.bullet | markdownify | remove: '<p>' | remove: '</p>' }}
                    {% elsif entry.label %}
                      <strong>{{ entry.label }}:</strong> {{ entry.details }}
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </article>
</div>
